{
  "name": "Feature Flag Flip Storms Downstream",
  "description": "PM toggles a single LaunchDarkly flag from 5% to 100% on the new search-personalization path. The new path makes 4 extra Postgres queries per request. p95 latency on search-svc holds, but the database CPU pegs at 95% and unrelated services start timing out.",
  "reasoning": "Search service + Postgres + an unrelated billing service that shares the same DB. The simulation captures the noisy-neighbour effect of one service ramping its DB usage 4x.",
  "category": "deploy",
  "difficulty": "medium",
  "nodes": [
    { "id": "vpc",     "type": "vpc",     "label": "platform-prod-vpc", "parent": null },
    { "id": "pubnet",  "type": "subnet",  "label": "platform-edge",     "parent": "vpc" },
    { "id": "appnet",  "type": "subnet",  "label": "platform-app",      "parent": "vpc" },
    { "id": "datanet", "type": "subnet",  "label": "platform-data",     "parent": "vpc" },
    { "id": "lb",      "type": "service", "serviceType": "nginx",    "label": "edge-lb",      "parent": "pubnet" },
    { "id": "search",  "type": "service", "serviceType": "golang",   "label": "search-svc",   "parent": "appnet" },
    { "id": "billing", "type": "service", "serviceType": "golang",   "label": "billing-svc",  "parent": "appnet",  "notes": "Shares the same Postgres." },
    { "id": "db",      "type": "service", "serviceType": "postgres", "label": "shared-pg",    "parent": "datanet" }
  ],
  "edges": [
    { "source": "lb",      "target": "search",  "protocol": "http", "port": 8080, "trafficRate": 80, "trafficPattern": "diurnal", "errorRate": 0.005 },
    { "source": "lb",      "target": "billing", "protocol": "http", "port": 8080, "trafficRate": 30, "trafficPattern": "steady",  "errorRate": 0.005 },
    { "source": "search",  "target": "db",      "protocol": "tcp",  "port": 5432, "trafficRate": 40, "trafficPattern": "steady",  "errorRate": 0.001 },
    { "source": "billing", "target": "db",      "protocol": "tcp",  "port": 5432, "trafficRate": 25, "trafficPattern": "steady",  "errorRate": 0.001 }
  ],
  "timeline": {
    "duration": 1080,
    "narrative": [
      { "tick": 0,    "text": "Healthy baseline. shared-pg CPU ~45%." },
      { "tick": 240,  "text": "PM bumps 'search-personalization-v2' from 5% → 100% in LaunchDarkly." },
      { "tick": 300,  "text": "search-svc DB query rate 4x. Postgres CPU climbs to 95% in 90 seconds." },
      { "tick": 420,  "text": "billing-svc starts seeing query timeouts; 5xx rate climbs even though billing logic is unchanged." },
      { "tick": 600,  "text": "Pager goes off for billing-svc. SRE traces it to flag flip via Datadog change-correlation." },
      { "tick": 780,  "text": "Flag dropped back to 5%; CPU normalises in 60 seconds." },
      { "tick": 960,  "text": "Steady state. Action: load-test new query paths before 100% rollout." }
    ],
    "lanes": {
      "search": [
        { "start": 0,    "duration": 240, "state": "healthy" },
        { "start": 240,  "duration": 540, "state": "degraded",   "note": "ramped query rate, latency edge" },
        { "start": 780,  "duration": 300, "state": "healthy" }
      ],
      "billing": [
        { "start": 0,    "duration": 420, "state": "healthy" },
        { "start": 420,  "duration": 360, "state": "degraded",   "note": "noisy-neighbour DB" },
        { "start": 780,  "duration": 300, "state": "healthy" }
      ],
      "db": [
        { "start": 0,    "duration": 240, "state": "healthy" },
        { "start": 240,  "duration": 540, "state": "under_attack", "note": "CPU 95%, queue building" },
        { "start": 780,  "duration": 300, "state": "healthy" }
      ]
    }
  }
}
