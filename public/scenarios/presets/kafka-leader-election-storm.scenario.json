{
  "name": "Kafka Broker Loss → Leader Election Storm",
  "description": "broker-3 dies hard (kernel panic on a flaky NIC). The ISR shrinks, partitions reshuffle, and a leader-election storm pushes p99 produce latency on the producers from 12ms to ~3 seconds. Consumers fall behind and the order pipeline lags.",
  "reasoning": "Producer Go service, three brokers, and a consumer worker. When one broker drops out, surviving brokers become leaders for many more partitions. Producer batches retry, latency climbs, the worker can't keep up and the downstream Postgres view goes stale.",
  "category": "incident",
  "difficulty": "hard",
  "nodes": [
    { "id": "vpc",     "type": "vpc",     "label": "data-platform-vpc", "parent": null },
    { "id": "pubnet",  "type": "subnet",  "label": "edge-public-2c",    "parent": "vpc" },
    { "id": "appnet",  "type": "subnet",  "label": "stream-app-2c",     "parent": "vpc" },
    { "id": "datanet", "type": "subnet",  "label": "stream-data-2c",    "parent": "vpc" },
    { "id": "lb",       "type": "service", "serviceType": "nginx",   "label": "events-ingest-lb",   "parent": "pubnet" },
    { "id": "producer", "type": "service", "serviceType": "golang",  "label": "events-producer",    "parent": "appnet",  "notes": "Sarama client, acks=all, idempotent." },
    { "id": "broker1",  "type": "service", "serviceType": "custom",  "label": "kfk-broker-1",       "parent": "datanet", "notes": "Kafka 3.6, KRaft mode." },
    { "id": "broker2",  "type": "service", "serviceType": "custom",  "label": "kfk-broker-2",       "parent": "datanet" },
    { "id": "broker3",  "type": "service", "serviceType": "custom",  "label": "kfk-broker-3",       "parent": "datanet", "notes": "Flaky NIC; bond0 is in degraded state." },
    { "id": "consumer", "type": "service", "serviceType": "golang",  "label": "orders-projector",   "parent": "appnet",  "notes": "Consumes events topic, writes to PG." },
    { "id": "pg",       "type": "service", "serviceType": "postgres","label": "orders-readmodel-db","parent": "datanet" }
  ],
  "edges": [
    { "source": "lb",       "target": "producer", "protocol": "http", "port": 8080, "trafficRate": 120, "trafficPattern": "bursty",   "errorRate": 0.005 },
    { "source": "producer", "target": "broker1",  "protocol": "tcp",  "port": 9092, "trafficRate": 80,  "trafficPattern": "steady",   "errorRate": 0.001 },
    { "source": "producer", "target": "broker2",  "protocol": "tcp",  "port": 9092, "trafficRate": 80,  "trafficPattern": "steady",   "errorRate": 0.001 },
    { "source": "producer", "target": "broker3",  "protocol": "tcp",  "port": 9092, "trafficRate": 80,  "trafficPattern": "steady",   "errorRate": 0.001 },
    { "source": "consumer", "target": "broker1",  "protocol": "tcp",  "port": 9092, "trafficRate": 60,  "trafficPattern": "steady",   "errorRate": 0.001 },
    { "source": "consumer", "target": "broker2",  "protocol": "tcp",  "port": 9092, "trafficRate": 60,  "trafficPattern": "steady",   "errorRate": 0.001 },
    { "source": "consumer", "target": "broker3",  "protocol": "tcp",  "port": 9092, "trafficRate": 60,  "trafficPattern": "steady",   "errorRate": 0.001 },
    { "source": "consumer", "target": "pg",       "protocol": "tcp",  "port": 5432, "trafficRate": 40,  "trafficPattern": "steady",   "errorRate": 0.001 }
