  "timeline": {
    "duration": 1500,
    "narrative": [
      { "tick": 0,    "text": "Steady event ingest, ~120 msgs/sec, p99 produce 12ms." },
      { "tick": 300,  "text": "kfk-broker-3 NIC starts dropping — TCP retransmits visible on broker-1's metrics." },
      { "tick": 360,  "text": "broker-3 marked offline by controller. Leader election kicks off for ~140 partitions." },
      { "tick": 480,  "text": "Producer p99 latency climbs to 2.8s; orders-projector consumer lag in the millions." },
      { "tick": 720,  "text": "Operators move the broker workload to a fresh VM and rejoin the cluster." },
      { "tick": 960,  "text": "Partitions rebalanced; lag draining at ~3K msg/sec." },
      { "tick": 1200, "text": "Consumer caught up; readmodel back to <500ms staleness." },
      { "tick": 1380, "text": "All green; root cause filed: bond0 misconfiguration in image baseline." }
    ],
