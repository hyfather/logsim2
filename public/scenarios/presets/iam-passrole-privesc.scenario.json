  "timeline": {
    "duration": 1500,
    "narrative": [
      { "tick": 0,    "text": "Quiet IAM/Lambda baseline. Normal CI builder activity." },
      { "tick": 240,  "text": "iam:GetRole on lambda-deploy-admin — 'ci-builder' is exploring; this is unusual." },
      { "tick": 360,  "text": "lambda:CreateFunction with Role=arn:aws:iam::*:role/lambda-deploy-admin succeeds." },
      { "tick": 540,  "text": "Function invokes itself. Inside, sts:AssumeRole granted; the temp creds have admin." },
      { "tick": 720,  "text": "From the Lambda, iam:CreateUser + iam:AttachUserPolicy → AdministratorAccess." },
      { "tick": 900,  "text": "GuardDuty: 'PrivilegeEscalation:IAMUser/AnomalousBehavior'. SOC paged." },
      { "tick": 1140, "text": "Backdoor user deleted; ci-builder access key disabled; PassRole + CreateFunction combo ripped out." },
      { "tick": 1380, "text": "Steady state. SCP added to deny iam:PassRole on tier-0 roles for non-tier-0 principals." }
    ],
    "lanes": {
