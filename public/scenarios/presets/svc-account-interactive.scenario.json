      { "tick": 420,  "text": "PowerShell launched on WIN-FS-PROD-04; whoami /groups, net group 'Domain Admins' /domain." },
      { "tick": 600,  "text": "Sysmon EID 1 records explorer.exe spawned; the original cron path used cmd.exe only." },
      { "tick": 780,  "text": "Splunk UEBA correlation 'service-account-interactive-logon' fires." },
