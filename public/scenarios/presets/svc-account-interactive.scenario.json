    { "id": "datanet", "type": "subnet",  "label": "siem-net",         "parent": "vpc" },
    { "id": "ad",      "type": "service", "serviceType": "custom",  "label": "ad-dc-01",            "parent": "edgenet",  "notes": "Windows Server 2019 DC." },
    { "id": "fs",      "type": "service", "serviceType": "custom",  "label": "WIN-FS-PROD-04",      "parent": "appnet",   "notes": "File server with RDP enabled." },
