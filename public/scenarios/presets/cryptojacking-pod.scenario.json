  "timeline": {
    "duration": 1500,
    "narrative": [
      { "tick": 0,    "text": "Steady weekend traffic; pricing-svc p95 100ms." },
      { "tick": 180,  "text": "Internet crawler hits the open NodePort; sends 'GET /api/v1/namespaces/default/pods'." },
      { "tick": 300,  "text": "Anonymous request returns 200 — RBAC misconfig means cluster-admin to anyone." },
      { "tick": 420,  "text": "Attacker creates pod 'debug-shell' on node-2 with a mining image (xmrig)." },
      { "tick": 540,  "text": "Node-2 CPU hits 100%; pricing-svc replica on node-2 latency triples." },
      { "tick": 720,  "text": "Falco rule 'unexpected-outbound-pool' fires (xmrig connecting to pool.minexmr.com)." },
      { "tick": 900,  "text": "SOC pulls the kubeconfig audit; sees pod created by 'system:anonymous'." },
      { "tick": 1080, "text": "kube-apiserver locked down (anonymous-auth=false); rogue pod deleted; node cordoned." },
      { "tick": 1320, "text": "Cluster scanned for persistence; nothing else found. Forensic image of node-2 captured." }
