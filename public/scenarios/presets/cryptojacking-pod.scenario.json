    { "id": "pubnet",  "type": "subnet",  "label": "k8s-public-nps",  "parent": "vpc" },
    { "id": "appnet",  "type": "subnet",  "label": "k8s-workloads",   "parent": "vpc" },
    { "id": "datanet", "type": "subnet",  "label": "k8s-data",        "parent": "vpc" },
    { "id": "lb",      "type": "service", "serviceType": "nginx",  "label": "ingress-controller", "parent": "pubnet" },
    { "id": "pricing", "type": "service", "serviceType": "golang", "label": "pricing-svc",        "parent": "appnet" },
    { "id": "catalog", "type": "service", "serviceType": "golang", "label": "catalog-svc",        "parent": "appnet" },
    { "id": "debug",   "type": "service", "serviceType": "custom", "label": "debug-shell-pod",    "parent": "appnet",  "notes": "Hackathon leftover. Privileged; cluster-admin SA." },
    { "id": "kube",    "type": "service", "serviceType": "custom", "label": "kube-apiserver",     "parent": "appnet",  "notes": "Exposed on a NodePort with anonymous auth allowed." },
    { "id": "redis",   "type": "service", "serviceType": "redis",  "label": "pricing-cache",      "parent": "datanet" }
  ],
  "edges": [
    { "source": "lb",     "target": "pricing", "protocol": "http", "port": 8080, "trafficRate": 70, "trafficPattern": "diurnal", "errorRate": 0.005 },
    { "source": "lb",     "target": "catalog", "protocol": "http", "port": 8080, "trafficRate": 60, "trafficPattern": "diurnal", "errorRate": 0.005 },
