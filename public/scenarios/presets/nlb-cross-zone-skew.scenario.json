{
  "name": "NLB Cross-Zone Imbalance",
  "description": "Cross-zone load balancing was disabled on the NLB during a cost-savings sweep last quarter. A client with sticky DNS resolution lands almost entirely on us-east-1c targets — that AZ saturates while the other two AZs sit at 20% CPU. P95 latency in 1c climbs and 5xx rates rise.",
  "reasoning": "Three Go API targets, one in each AZ, all behind a single NLB. The simulation models the imbalance as healthy 1a/1b services and a saturated 1c service, with downstream Postgres taking uneven query load.",
  "category": "incident",
  "difficulty": "medium",
  "nodes": [
    { "id": "vpc",     "type": "vpc",    "label": "platform-prod-vpc", "parent": null },
    { "id": "pubnet",  "type": "subnet", "label": "edge-public",       "parent": "vpc" },
    { "id": "appa",    "type": "subnet", "label": "app-private-1a",    "parent": "vpc" },
    { "id": "appb",    "type": "subnet", "label": "app-private-1b",    "parent": "vpc" },
    { "id": "appc",    "type": "subnet", "label": "app-private-1c",    "parent": "vpc" },
    { "id": "datanet", "type": "subnet", "label": "data-private",      "parent": "vpc" },
    { "id": "lb",  "type": "service", "serviceType": "nginx",    "label": "platform-nlb",     "parent": "pubnet" },
    { "id": "a1",  "type": "service", "serviceType": "golang",   "label": "platform-api-1a",  "parent": "appa" },
    { "id": "a2",  "type": "service", "serviceType": "golang",   "label": "platform-api-1b",  "parent": "appb" },
    { "id": "a3",  "type": "service", "serviceType": "golang",   "label": "platform-api-1c",  "parent": "appc",   "notes": "This AZ takes ~75% of traffic." },
    { "id": "db",  "type": "service", "serviceType": "postgres", "label": "platform-db",      "parent": "datanet" }
  ],
  "edges": [
    { "source": "lb", "target": "a1", "protocol": "http", "port": 8080, "trafficRate": 35,  "trafficPattern": "diurnal", "errorRate": 0.005 },
    { "source": "lb", "target": "a2", "protocol": "http", "port": 8080, "trafficRate": 35,  "trafficPattern": "diurnal", "errorRate": 0.005 },
    { "source": "lb", "target": "a3", "protocol": "http", "port": 8080, "trafficRate": 180, "trafficPattern": "diurnal", "errorRate": 0.02 },
