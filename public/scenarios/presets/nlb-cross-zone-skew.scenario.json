    { "source": "a2", "target": "db", "protocol": "tcp",  "port": 5432, "trafficRate": 18,  "trafficPattern": "steady",  "errorRate": 0.001 },
    { "source": "a3", "target": "db", "protocol": "tcp",  "port": 5432, "trafficRate": 90,  "trafficPattern": "steady",  "errorRate": 0.001 }
  ],
  "timeline": {
    "duration": 1200,
    "narrative": [
      { "tick": 0,    "text": "Morning ramp; no obvious issue, but 1c CPU sits noticeably higher than peers." },
      { "tick": 240,  "text": "1c CPU pegs at 95%; p95 latency on platform-api-1c jumps from 80ms to 1.4s." },
      { "tick": 360,  "text": "Pages fire. Customer reports correlate to a single AZ — Datadog shows the skew." },
      { "tick": 540,  "text": "On-call discovers cross-zone is OFF; flips it on. NLB rebalances within 30s." },
      { "tick": 720,  "text": "Latency normalises across 1a/1b/1c; 1c CPU drops to 55%." },
      { "tick": 1020, "text": "Steady state. Action item: enable cross-zone in Terraform and add an AZ-balance alert." }
