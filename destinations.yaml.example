destinations:
  - name: prod-cribl
    type: cribl_hec
    enabled: true
    url: https://your-cribl-instance.example.com/services/collector/event
    token: your-hec-token-here
    batch_size: 100
    flush_interval_ms: 2000
    # format: native | ocsf | otel | udm | asim
    # Default is native (the generator's own log line). Set to "ocsf" to
    # forward OCSF v1.x JSON events, or "otel" for OpenTelemetry OTLP/JSON
    # LogRecord envelopes.
    format: native

  - name: staging-cribl-ocsf
    type: cribl_hec
    enabled: false
    url: https://staging.example.com/services/collector/event
    token: staging-token-here
    batch_size: 50
    flush_interval_ms: 5000
    format: ocsf
